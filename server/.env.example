# Copy to server/.env (npm run setup does this automatically)
HG_ENV=development
HG_DATABASE_URL=postgresql+psycopg://hangyul:hangyul_dev@localhost:5432/hangyul_univ
HG_TEST_DATABASE_URL=postgresql+psycopg://hangyul:hangyul_dev@localhost:5432/hangyul_univ_test
HG_REDIS_URL=redis://localhost:6379/5
# Generate a strong secret for any non-local environment: python -c "import secrets;print(secrets.token_urlsafe(48))"
HG_JWT_SECRET=dev-only-change-me-in-any-shared-environment-0123456789
HG_FILE_URL_SECRET=dev-only-file-url-secret-0123456789
HG_ACCESS_TOKEN_MINUTES=15
HG_REFRESH_TOKEN_DAYS=14
HG_CORS_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:3102,http://localhost:3103,http://127.0.0.1:3100,http://127.0.0.1:3101,http://127.0.0.1:3102,http://127.0.0.1:3103,http://localhost:8081,http://localhost:8082,http://localhost:8083
HG_STORAGE_BACKEND=local
HG_STORAGE_DIR=./var/uploads
HG_MAX_UPLOAD_MB=15
HG_PAYMENT_PROVIDER=demo
# HG_STRIPE_SECRET_KEY=
# HG_TOSS_SECRET_KEY=
HG_MALWARE_SCANNER=noop

# ---------------------------------------------------------------- Toss Payments (V16, REPORT §135)
# Set HG_PAYMENT_PROVIDER=toss and fill the one-time configuration to run a real TEST checkout.
# NEVER commit real values: server/.env is gitignored, this example file is not.
HG_TOSS_ENV=test
HG_TOSS_RETURN_ORIGIN=http://localhost:3101
# D — one-time payment (일반 결제). The plan-purchase MID; its client key is the only value sent to a browser.
HG_TOSS_NORMAL_MID=
HG_TOSS_NORMAL_CLIENT_KEY=
HG_TOSS_NORMAL_SECRET_KEY=
HG_TOSS_NORMAL_SECURITY_KEY=
# A / B / C — 자동결제 billing-key registration MIDs. Configured, never reachable from the plan purchase.
HG_TOSS_DOMESTIC_BILLING_MID=
HG_TOSS_DOMESTIC_BILLING_CLIENT_KEY=
HG_TOSS_DOMESTIC_BILLING_SECRET_KEY=
HG_TOSS_DOMESTIC_BILLING_SECURITY_KEY=
HG_TOSS_FOREIGN_BILLING_MID=
HG_TOSS_FOREIGN_BILLING_CLIENT_KEY=
HG_TOSS_FOREIGN_BILLING_SECRET_KEY=
HG_TOSS_FOREIGN_BILLING_SECURITY_KEY=
HG_TOSS_EASYPAY_BILLING_MID=
HG_TOSS_EASYPAY_BILLING_CLIENT_KEY=
HG_TOSS_EASYPAY_BILLING_SECRET_KEY=
HG_TOSS_EASYPAY_BILLING_SECURITY_KEY=

# ---------------------------------------------------------------- V22 — identity providers (server-only; REPORT §253)
# Both spellings are read (with or without the HG_ prefix). Never commit values. Production refuses to start without them.
# SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=support@talkhangyul.com
SENDGRID_FROM_NAME=Hangyul Univ
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=            # used only to validate Twilio status-callback signatures
# TWILIO_MESSAGING_SERVICE_SID=
# PUBLIC_API_ORIGIN=https://api.example.com   # lets Twilio reach /api/v1/auth/webhooks/twilio/status
# TURNSTILE_SITE_KEY=           # Cloudflare test keys for development: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
# TURNSTILE_SECRET_KEY=
# QA_SMS_TARGET=+8210XXXXXXXX    # the ONLY numbers the provider smoke may message
# QA_EMAIL_TARGET=qa@example.com
