# Copy to server/.env (npm run setup does this automatically)
HG_ENV=development
HG_DATABASE_URL=postgresql+psycopg://hangyul:hangyul_dev@localhost:5432/hangyul_univ
HG_TEST_DATABASE_URL=postgresql+psycopg://hangyul:hangyul_dev@localhost:5432/hangyul_univ_test
HG_REDIS_URL=redis://localhost:6379/5
# Generate a strong secret for any non-local environment: python -c "import secrets;print(secrets.token_urlsafe(48))"
HG_JWT_SECRET=dev-only-change-me-in-any-shared-environment-0123456789
HG_FILE_URL_SECRET=dev-only-file-url-secret-0123456789
HG_ACCESS_TOKEN_MINUTES=15
HG_REFRESH_TOKEN_DAYS=14
HG_CORS_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:3102,http://localhost:3103,http://127.0.0.1:3100,http://127.0.0.1:3101,http://127.0.0.1:3102,http://127.0.0.1:3103,http://localhost:8081,http://localhost:8082,http://localhost:8083
HG_STORAGE_BACKEND=local
HG_STORAGE_DIR=./var/uploads
HG_MAX_UPLOAD_MB=15
HG_PAYMENT_PROVIDER=demo
# HG_STRIPE_SECRET_KEY=
HG_MALWARE_SCANNER=noop

# ---------------------------------------------------------------- Toss Payments — billing key only
# Owner decision: EVERY real purchase is  register payment method → billing key → ONE server-side charge.
# Products are one-time purchases: no schedule, no renewal. There is no ordinary-payment rail and no fallback.
# NEVER commit real values: server/.env is gitignored, this example file is not. In production these come from
# the host's secret store (or HG_*_FILE secret mounts) — never from a file in the tree, never from a frontend env.
#
# Set HG_PAYMENT_PROVIDER=toss to use it. HG_TOSS_ENV decides the mode and is never inferred or downgraded:
#   test → every key must be a test_ key      live → every key must be a live_ key
HG_TOSS_ENV=test
HG_TOSS_RETURN_ORIGIN=http://localhost:3101
# AES-256-GCM key that seals stored billing keys (32 bytes, base64url). Required; no default.
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
HG_PAYMENT_TOKEN_ENCRYPTION_KEY=
# A — domestic card billing (live MID bill_talko18s0)
HG_TOSS_DOMESTIC_BILLING_MID=
HG_TOSS_DOMESTIC_BILLING_CLIENT_KEY=
HG_TOSS_DOMESTIC_BILLING_SECRET_KEY=
HG_TOSS_DOMESTIC_BILLING_SECURITY_KEY=
HG_TOSS_DOMESTIC_BILLING_CURRENCY=KRW
# B — international card billing (live MID bill_talkoab1)
HG_TOSS_FOREIGN_BILLING_MID=
HG_TOSS_FOREIGN_BILLING_CLIENT_KEY=
HG_TOSS_FOREIGN_BILLING_SECRET_KEY=
HG_TOSS_FOREIGN_BILLING_SECURITY_KEY=
HG_TOSS_FOREIGN_BILLING_CURRENCY=USD
# C — easy-pay billing: Toss Pay / Naver Pay (live MID bill_talkspm0)
HG_TOSS_EASYPAY_BILLING_MID=
HG_TOSS_EASYPAY_BILLING_CLIENT_KEY=
HG_TOSS_EASYPAY_BILLING_SECRET_KEY=
HG_TOSS_EASYPAY_BILLING_SECURITY_KEY=
HG_TOSS_EASYPAY_BILLING_CURRENCY=KRW
# The currency each MID settles is a CONTRACT fact (one MID = one currency). An order is only charged on a
# merchant whose currency equals the order's; nothing is converted. Set these to what the contract says.
#
# Capability per method on the live merchant: UNVERIFIED | VERIFIED | BLOCKED. Set VERIFIED only after a real
# provider response confirmed registration → billing key → charge on that MID (docs/payments/BILLING.md).
HG_TOSS_CAPABILITY_DOMESTIC_CARD=UNVERIFIED
HG_TOSS_CAPABILITY_FOREIGN_CARD=UNVERIFIED
HG_TOSS_CAPABILITY_TOSS_PAY=UNVERIFIED
HG_TOSS_CAPABILITY_NAVER_PAY=UNVERIFIED
# Master switch for charging real money. Live keys alone do not charge. Turn on ONLY on the production
# payment host (HTTPS, durable hosting, production database, backups, monitoring) — never on a dev tunnel.
HG_LIVE_PAYMENT_ENABLED=false
# Refunds are decided by a person and executed from Operations; students cannot name their own refund.
HG_STUDENT_SELF_REFUND_ENABLED=false

# ---------------------------------------------------------------- V22 — identity providers (server-only; REPORT §253)
# Both spellings are read (with or without the HG_ prefix). Never commit values. Production refuses to start without them.
# SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=support@talkhangyul.com
SENDGRID_FROM_NAME=Hangyul Univ
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=            # used only to validate Twilio status-callback signatures
# TWILIO_MESSAGING_SERVICE_SID=
# PUBLIC_API_ORIGIN=https://api.example.com   # lets Twilio reach /api/v1/auth/webhooks/twilio/status
# STUDENT_APP_URL=https://app.example.com    # sign-in / reset links in identity emails (omitted when unset)
# TURNSTILE_SITE_KEY=           # Cloudflare test keys for development: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
# TURNSTILE_SECRET_KEY=
# QA_SMS_TARGET=+8210XXXXXXXX    # the ONLY numbers the provider smoke may message
# QA_EMAIL_TARGET=qa@example.com
