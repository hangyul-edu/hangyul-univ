{
  "name": "hangyul-univ",
  "private": true,
  "version": "0.1.0",
  "description": "Hangyul Univ — everything you need to study in Korea, from your first question to graduation.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/api.mjs",
    "dev:marketing": "npm run dev -w @hangyul/marketing-web",
    "dev:student": "npm run dev -w @hangyul/student-web",
    "dev:agency": "npm run dev -w @hangyul/agency-web",
    "dev:university": "npm run dev -w @hangyul/university-web",
    "dev:mobile:student": "npm run start -w @hangyul/student-mobile",
    "dev:mobile:agency": "npm run start -w @hangyul/agency-mobile",
    "dev:mobile:university": "npm run start -w @hangyul/university-mobile",
    "db:migrate": "node scripts/api.mjs migrate",
    "db:seed": "node scripts/api.mjs seed",
    "db:reset": "node scripts/api.mjs reset",
    "typecheck": "node scripts/run-seq.mjs typecheck",
    "build": "node scripts/run-seq.mjs build",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node scripts/api.mjs test",
    "test:web": "node scripts/run-seq.mjs test",
    "test:e2e": "playwright test",
    "lint:api": "node scripts/api.mjs lint",
    "i18n:check": "node packages/i18n/scripts/gen-resources.mjs && node packages/i18n/scripts/check.mjs",
    "tokens:build": "node packages/design-tokens/scripts/build-css.mjs",
    "flags:build": "node scripts/i18n/generate-flag-module.mjs",
    "qa:leak": "node scripts/qa/v12-leak-scan.mjs",
    "qa:legal": "node scripts/qa/v12-legal-gate.mjs",
    "qa:data-map": "node scripts/qa/v12-privacy-data-map.mjs",
    "qa:v12": "npm run qa:data-map && npm run qa:legal && npm run qa:leak",
    "catalog:import": "python3 scripts/catalog/import_korean_universities.py",
    "catalog:map": "python3 scripts/catalog/build_korea_map.py",
    "release:check": "node scripts/release/v29-release-check.mjs",
    "qa:composition": "node scripts/qa/v13-composition.mjs",
    "qa:countries": "node scripts/qa/v13-country-probe.mjs",
    "qa:v13": "npm run qa:composition && npm run qa:countries",
    "qa:marquee": "node scripts/qa/v14-marquee.mjs",
    "qa:marquee-details": "node scripts/qa/v14-marquee-details.mjs",
    "qa:media": "node scripts/qa/v14-media-licence.mjs",
    "qa:footer": "node scripts/qa/v14-footer.mjs",
    "qa:locale-url": "node scripts/qa/v14-locale-url.mjs",
    "qa:crests": "python3 scripts/media/normalize_crests.py audit --strict && python3 scripts/media/build_marquee_manifest.py --check",
    "qa:flags": "node scripts/media/sync-flags.mjs --check",
    "qa:v14": "npm run qa:media && npm run qa:flags && npm run qa:crests && npm run qa:surface && npm run qa:polish && npm run qa:marquee && npm run qa:marquee-details && npm run qa:footer && npm run qa:locale-url && npm run qa:locales && npm run qa:services",
    "qa:locales": "node scripts/qa/v14-locales.mjs",
    "qa:surface": "node scripts/qa/v14-surface.mjs",
    "qa:polish": "node scripts/qa/v14-polish.mjs",
    "qa:services": "node scripts/qa/v14-services-locale.mjs",
    "plans:sync": "node scripts/plans/sync.mjs",
    "admissions:sync": "node scripts/admissions/sync.mjs",
    "qa:pricing": "node scripts/qa/v29/plans.mjs",
    "qa:entitlements": "node scripts/qa/v29/plans.mjs",
    "qa:handoff": "node scripts/qa/v15-handoff.mjs",
    "qa:agency": "node scripts/qa/v15-agency.mjs",
    "qa:university": "node scripts/qa/v15-university.mjs",
    "qa:v15": "npm run qa:pricing && npm run qa:entitlements && npm run qa:handoff",
    "qa:v16": "node scripts/qa/v16-gate.mjs",
    "qa:v16-shots": "node scripts/qa/v16-capture.mjs",
    "review:fixtures": "node scripts/review/export-fixtures.mjs",
    "review:build": "node scripts/review/build.mjs",
    "qa:v17": "node scripts/qa/v17-gate.mjs",
    "qa:v18-locales": "node scripts/qa/v18-locale-coverage.mjs",
    "qa:v18": "node scripts/qa/v18-gate.mjs",
    "qa:v18-shots": "node scripts/qa/v18-student-shots.mjs",
    "release:collect": "node scripts/release/v18-collect.mjs",
    "qa:v19": "node scripts/qa/v19-gate.mjs",
    "qa:v19-errors": "node scripts/qa/v19/error-matrix.mjs",
    "qa:v19-student": "node scripts/qa/v19/student-sweep.mjs",
    "qa:v19-consoles": "node scripts/qa/v19/console-sweep.mjs agency && node scripts/qa/v19/console-sweep.mjs university",
    "qa:v19-clickmap": "node scripts/qa/v19/click-map.mjs",
    "qa:v19-locales": "node scripts/qa/v19/locale-shots.mjs",
    "qa:v19-journey": "node scripts/qa/v19/journey.mjs",
    "qa:v19-native-a11y": "node scripts/qa/v19/native-a11y.mjs",
    "qa:v19-native-runtime": "node scripts/qa/v19/native-runtime.mjs",
    "qa:v20": "node scripts/qa/v20-gate.mjs",
    "qa:v20-static": "node scripts/qa/v20-gate.mjs --static",
    "qa:v20-buttons": "node scripts/qa/v20/button-matrix.mjs",
    "qa:v20-shots": "node scripts/qa/v20/capture.mjs",
    "uni:audit": "node scripts/universities/audit-content.mjs",
    "uni:research": "node scripts/universities/research-official.mjs",
    "uni:media": "node scripts/universities/harvest-media.mjs",
    "uni:youtube": "node scripts/universities/verify-youtube.mjs",
    "uni:curate": "node scripts/universities/apply-curated.mjs",
    "native:debug-apk": "cd apps/student-mobile && npx expo prebuild --platform android --clean --no-install && cd android && ./gradlew --no-daemon --max-workers=1 :app:assembleDebug",
    "review:serve": "npx --yes serve@14 -s dist-review -l 4173",
    "test:release": "node scripts/release/test-release.mjs",
    "qa:v21": "node scripts/qa/v21-gate.mjs && node scripts/qa/v21/security-scan.mjs",
    "qa:v21-static": "node scripts/qa/v21-gate.mjs --static",
    "qa:v21-payment": "node scripts/qa/v21/toss-test-transaction.mjs",
    "qa:v21-security": "node scripts/qa/v21/security-scan.mjs",
    "qa:v21-shots": "node scripts/qa/v21/capture.mjs",
    "qa:v22": "node scripts/qa/v22-gate.mjs && node scripts/qa/v22/provider-smoke.mjs && node scripts/qa/v21/security-scan.mjs --no-runtime",
    "qa:v22-static": "node scripts/qa/v22-gate.mjs --static",
    "qa:v22-smoke": "node scripts/qa/v22/provider-smoke.mjs",
    "qa:identity-live": "cd server && HG_ENV=development .venv/bin/python -m scripts.v27_identity_live",
    "qa:v22-register": "node scripts/qa/v22/_register-walk.mjs",
    "qa:v23": "node scripts/qa/v23-gate.mjs",
    "qa:v24": "node scripts/qa/v24-gate.mjs",
    "qa:v23-native": "node scripts/qa/v23-gate.mjs --part native",
    "qa:v23-built": "node scripts/qa/v23-gate.mjs --part built",
    "qa:v23-crawl": "node scripts/qa/v23/crawl.mjs",
    "qa:v25": "node scripts/qa/v25-gate.mjs",
    "qa:v26": "node scripts/qa/v26-gate.mjs",
    "qa:v26-scale": "node scripts/qa/v26/scale.mjs",
    "qa:v26-census": "node scripts/qa/v26/census.mjs",
    "qa:v26-css": "node scripts/qa/v26/css-metrics.mjs",
    "qa:v27": "node scripts/qa/v27/static.mjs",
    "qa:v27-buttons": "node scripts/qa/v27/buttons.mjs",
    "qa:v27-marquee": "node scripts/qa/v27/marquee.mjs",
    "i18n:v27": "node scripts/i18n/v27/validate.mjs",
    "qa:v28-visual": "node scripts/qa/v28/visual.mjs",
    "i18n:v28": "node scripts/i18n/v28/validate.mjs",
    "qa:v28-particles": "node scripts/i18n/v28/particles.mjs --check",
    "qa:plans-v29": "node scripts/qa/v29/plans.mjs",
    "qa:addons-v29": "node scripts/qa/v29/addons.mjs",
    "i18n:console-locales": "node scripts/i18n/v29/console-locales.mjs --check",
    "release:check-v13": "node scripts/qa/v13-release-check.mjs",
    "qa:v29-chain": "bash scripts/qa/v29/chain.sh",
    "qa:v30-marquee": "node scripts/qa/v30/marquee.mjs",
    "qa:v30-directory": "node scripts/qa/v30/directory.mjs",
    "qa:v30-visual": "node scripts/qa/v30/visual.mjs --check",
    "qa:v30-routes": "node scripts/qa/v30/routes.mjs",
    "qa:v30": "bash scripts/qa/v30/chain.sh",
    "qa:v31-l10n": "node scripts/qa/v31/l10n.mjs",
    "qa:v31-stage": "node scripts/qa/v31/stage.mjs",
    "qa:v31-pricing": "node scripts/qa/v31/pricing.mjs",
    "qa:v31": "bash scripts/qa/v31/chain.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "concurrently": "^9.2.4",
    "typescript": "~5.9.3",
    "@types/node": "^22.10.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
