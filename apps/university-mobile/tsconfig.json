{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "paths": {
      "@hangyul/mobile-ui": [
        "../../packages/mobile-ui/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/mobile-ui/src/**/*.ts",
    "../../packages/mobile-ui/src/**/*.tsx"
  ]
}
