{
  "expo": {
    "name": "Hangyul Univ",
    "slug": "hangyul-student",
    "scheme": "hangyul-student",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-1024.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#CC4E00",
    "ios": {
      "bundleIdentifier": "kr.hangyul.univ.student",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kr.hangyul.univ.student",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground-1024.png",
        "backgroundColor": "#FFF3E8"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      "expo-system-ui",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#FFFDF8"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Hangyul uses the camera so you can photograph a document and upload it.",
          "photosPermission": "Hangyul opens your photos so you can choose a document to upload.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#CC4E00"
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withQaCleartext"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://localhost:8001",
      "client": "student",
      "apiUrlNotes": "Override with EXPO_PUBLIC_API_URL. Android emulator: http://10.0.2.2:8001. Physical device: http://<your-LAN-IP>:8001.",
      "webUrl": "http://localhost:3101",
      "webUrlNotes": "Where the student web app lives. Override with EXPO_PUBLIC_STUDENT_WEB_URL. The app opens its /services checkout in the system browser and comes back by deep link, so this must be a host the device can reach: the LAN IP in development, the public origin in production."
    }
  }
}
