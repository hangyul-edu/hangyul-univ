{
  "expo": {
    "name": "Hangyul Agency",
    "slug": "hangyul-agency",
    "scheme": "hangyul-agency",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFFDF8"
    },
    "ios": {
      "bundleIdentifier": "kr.hangyul.univ.agency",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "kr.hangyul.univ.agency",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground-1024.png",
        "backgroundColor": "#FFF3E8"
      },
      "versionCode": 1
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Hangyul uses the camera so you can photograph a document and upload it.",
          "photosPermission": "Hangyul opens your photos so you can choose a document to upload.",
          "microphonePermission": false
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withQaCleartext"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://localhost:8001",
      "client": "agency",
      "apiUrlNotes": "Override with EXPO_PUBLIC_API_URL. Android emulator: http://10.0.2.2:8001. Physical device: http://<your-LAN-IP>:8001."
    },
    "primaryColor": "#CC4E00"
  }
}
