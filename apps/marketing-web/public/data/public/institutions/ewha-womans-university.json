curated/philosophy.json.","statements":[{"kind":"educational","quote":"이화여자대학교는 대한민국의 교육이념과 기독교정신을 바탕으로 하여 학술의 깊은 이론과 그 광범하고 정밀한 응용방법을 교수·연구하며, 인격을 도야하여 국가와 인류사회의 발전에 공헌할 수 있는 지도여성을 양성함을 목적으로 한다.(학칙 제1조) 한 세기를 훨씬 넘어선 이화의 역사는 바로 기적과 창조의 역사였다. 여성의 인격화를 통하여 모든 인간을 구원하려 했던 하나님의 사랑의 역사는 이화를 통해 한국 여성사와 민족사에서 간과할 수 없는 큰 족적을 남겨 왔다. 이화가 이룬 교육적 성과는 창립 이래 이화가 견지해 온 남다른 교육목적이 있었기 때문에 가능할 수 있었다.","heading":"교육목적","fetched_at":"2026-10-23","source_url":"https://www.ewha.ac.kr/ewha/intro/object.do"}],"verification_status":"SOURCED_UNREVIEWED"},"international_office_url":"https://www.ewha.ac.kr/ewha/bachelor/exchange01.do","international_admissions_url":"https://www.ewha.ac.kr/ewha/admission/admission.do"},"signals":{"gks":true,"english_degrees":true},"registry_name_ko":null,"establishment_source":"사립","other_campuses":[],"latitude":37.5625,"longitude":126.945,"ieqas_checked_on":"2026-03-03","sources":{"registry":{"name":"대학알리미","url":"https://www.academyinfo.go.kr","survey_year":"2025","checked":"2026-10-17"},"reference":{"name":"Wikidata","url":"https://www.wikidata.org/wiki/Q41114","checked":"2026-10-17"},"international":{"name":"Study in Korea","url":"https://www.studyinkorea.go.kr/ko/plan/certifiedUniversity.do","checked":"2026-03-03"}}}
