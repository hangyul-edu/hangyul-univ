.postech.ac.kr/kor/index.do","status":"OK","checked":"2026-10-23","pages_read":4,"website_source":"registry"},"philosophy_url":"https://www.postech.ac.kr/kor/university-introduction/establishment.do","youtube_candidates":{"links":["https://www.youtube.com/user/postechvision2020"],"found_on":"https://www.postech.ac.kr/kor/index.do","verified_at":"2026-10-23","found_on_v22":{"https://www.youtube.com/user/postechvision2020":"https://www.postech.ac.kr/kor/index.do"}},"philosophy_candidate":{"_note":"Verbatim text from the institution’s own page, captured by v22-research-official.mjs. Not rendered. Review → curated/philosophy.json.","statements":[{"kind":"founding","quote":"포항공과대학은 우리나라와 인류사회 발전에 절실히 필요한 과학과 기술의 심오한 이론과 광범위한 응용방법을 깊이 있게 연구하고, 소수의 영재를 모아 질 높은 교육을 실시함으로써 지식과 지성을 겸비한 국제적 수준의 고급인재를 양성함과 아울러, 산·학·연 협동의 구체적인 실현을 통하여 연구한 결과를 산업체에 전파함으로써 사회와 인류에 봉사할 목적으로 설립되었다. 이러한 목적에 따라 포항공과대학은 세계적인 대학들과 긴밀히 협력하여 기초과학과 공학 각 분야의 첨단적인 연구에 중점을 두는 한편 소재산업 관련 연구에서는 세계적인 중심지로 발전하고자 한다.","heading":"건학이념","fetched_at":"2026-10-23","source_url":"https://www.postech.ac.kr/kor/university-introduction/establishment.do"}],"verification_status":"SOURCED_UNREVIEWED"},"international_admissions_url":"https://www.postech.ac.kr/kor/admission/admission_info.do"},"signals":{"gks":true,"english_degrees":true},"registry_name_ko":null,"establishment_source":"사립","other_campuses":[],"latitude":36.01088,"longitude":129.32267,"ieqas_checked_on":"2026-03-03","sources":{"registry":{"name":"대학알리미","url":"https://www.academyinfo.go.kr","survey_year":"2025","checked":"2026-10-17"},"reference":{"name":"Wikidata","url":"https://www.wikidata.org/wiki/Q40018","checked":"2026-10-17"},"international":{"name":"Study in Korea","url":"https://www.studyinkorea.go.kr/ko/plan/certifiedUniversity.do","checked":"2026-03-03"}}}
