{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci --no-audit --no-fund",
  "buildCommand": "cd ../.. && npm run build -w @hangyul/marketing-web && node scripts/public-data/stage-fit.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/public-fit.py": {
      "includeFiles": "{api/_fit/**,public/data/public/fit-snapshot.json,public/data/public/admissions/**}",
      "excludeFiles": "{dist/**,dist-*/**,public/media/**,public/flags/**,public/og/**,node_modules/**,src/**,.vercel/**,*.png,*.ico}",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/public/fit",
      "destination": "/api/public-fit"
    },
    {
      "source": "/api/v1/directory/institutions/:slug/admissions",
      "destination": "/api/public-fit?admissions=:slug"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.univ.talkhangyul.com/api/:path*"
    },
    {
      "source": "/((?!assets/|data/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com https://challenges.cloudflare.com; worker-src 'self' blob:; media-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/build-info.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
